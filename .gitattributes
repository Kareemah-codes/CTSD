# Normalize line endings for all files
* text=auto

# Explicitly use LF for these file types (cross-platform standard)
*.md text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cmake text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.jar binary
